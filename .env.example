# Copy to .env and fill in for `docker run --env-file .env ...`. Never commit .env.

# Required. Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Strongly recommended
GEOCODER_USER_AGENT=DoorKickWatch/1.0 (https://yoursite.org; you@yoursite.org)
CONTACT_EMAIL=you@yoursite.org
DEFAULT_VIEW=40.71,-74.00,12
COUNTRY_CODES=us

# Set to 1 if a proxy / load balancer / HTTPS terminator sits in front of the app
TRUST_PROXY=1

# Optional
# SITE_NAME=Door Kick Watch
# PUBLIC_GRID_METERS=150
# MAX_REPORTS_PER_HOUR=5
# MAX_GEOCODES_PER_MINUTE=20
